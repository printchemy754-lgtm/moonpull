<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application>
        <!-- Registers the plugin with Godot (Android plugin v2). -->
        <meta-data
            android:name="org.godotengine.plugin.v2.GodotAds"
            android:value="com.dwarf.godotads.GodotAds" />

        <!-- AdMob App ID. This is Google's TEST id; CI replaces it with the
             ADMOB_APP_ID repository secret when that secret is set. -->
