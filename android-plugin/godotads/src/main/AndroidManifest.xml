<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application>
        <!-- Registers the plugin with Godot (Android plugin v2). -->
        <meta-data
            android:name="org.godotengine.plugin.v2.GodotAds"
            android:value="com.dwarf.godotads.GodotAds" />

        <!-- AdMob App ID of "MoonPull" (works with both test and real ad units). -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-7224699187685418~1990333465" />

        <!-- AdMob and Firebase Analytics both declare this property with different
             files; without this line the Android build fails (manifest merger). -->
        <property
            android:name="android.adservices.AD_SERVICES_CONFIG"
            android:resource="@xml/gma_ad_services_config"
            tools:replace="android:resource" />
    </application>
</manifest>
